{
    "name": "metrictower/funnypot-wordpress",
    "description": "Thin WordPress adapter over the funnypot-policy decision engine (piece D). Normalizes the WP request, asks the shared policy engine for a Decision, and executes it. All decision logic lives in funnypot-policy.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=7.3",
        "metrictower/funnypot-policy": "~0.0.1",
        "metrictower/funnypot-core": "~0.0.1",
        "metrictower/funnypot-mainnet-client": "~0.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Honeypot\\WP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Honeypot\\WP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": false
        }
    }
}
