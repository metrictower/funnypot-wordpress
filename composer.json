{
    "name": "metrictower/funnypot-wordpress",
    "description": "WordPress plugin for funnypot: normalise the WP request, ask the funnypot-policy decision engine, execute the Decision (allow / log / block / deceive). Owns no decision logic.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=7.3",
        "metrictower/funnypot-policy": "^0.1",
        "metrictower/funnypot-core": "^0.4",
        "metrictower/funnypot-mainnet-client": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Funnypot\\WordPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Funnypot\\WordPress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": false
        }
    }
}
